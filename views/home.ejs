<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Pink Elegant Chat UI</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <%- include("partials/css") %>
</head>

<body>

    <div class="container-fluid p-0">
        <div class="chat-container">

            <!-- Header -->
            <div class="chat-header">
                <div class="d-flex align-items-center">
                    <!-- <img src="https://via.placeholder.com/45" alt="Profile"> -->
                    <div class="ms-3">
                        <h6 class="mb-0 fw-bold">Angel Spa</h6>
                        <div class="online-status">Online</div>
                    </div>
                </div>
                <button class="btn btn-sm text-dark border-0 fs-4">⋮</button>
            </div>

            <!-- Chat Body -->
            <div class="chat-body">
                <!-- <div class="message received">
                    Hello 💕 Welcome to Angel Spa
                </div>

                <div class="message sent">
                    Hi, mujhe Swedish massage booking karni hai.
                </div>

                <div class="message received">
                    Sure 😊 Aapka preferred time bataiye.
                </div>

                <div class="message sent">
                    Evening 7 PM available hai?
                </div>

                <div class="message received">
                    Yes 💖 Slot available hai.
                </div> -->
            </div>

            <!-- Footer -->
            <form action="/apiendpoint" method="POST" id="chatForm">
                <div class="chat-footer">
                    <div class="input-group">
                        <input name="requestmessage" id="requestmessage" type="text" class="form-control"
                            placeholder="Type your message...">
                        <button type="submit" class="btn ms-2">➤</button>
                    </div>
                </div>
            </form>

        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        document.getElementById("chatForm").onsubmit = async function (e) {
            e.preventDefault();

            let htmlStr = '<div class="message sent">' + document.getElementById("requestmessage").value + '</div>';
            $('.chat-body').append(htmlStr);

            try {
                const response = await fetch("/apiendpoint", {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json"
                    },
                    body: JSON.stringify({
                        message: $('#requestmessage').val()
                    })
                }); $('#requestmessage').val('');

                const data = await response.json();

                if (data.success) {
                    let htmlStr = '<div class="message received">' + data.message + '</div>';
                    $('.chat-body').append(htmlStr); $('#requestmessage').val('');
                    $(".chat-body").scrollTop($(".chat-body")[0].scrollHeight);
                } else {
                    console.error("Error:", data.message);
                }

            } catch (error) {
                console.error("Error:", error);
            }
        };


    </script>

</body>

</html>